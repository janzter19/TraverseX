[Unit]
Description=TraverseX Firebase to MySQL worker (%i)
After=network-online.target mariadb.service
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=traversex
Group=traversex
WorkingDirectory=/var/www/html/traverseX
EnvironmentFile=/etc/traversex/%i.env
ExecStart=/usr/local/bin/node /var/www/html/traverseX/src/worker.mjs
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/traversex

[Install]
WantedBy=multi-user.target
