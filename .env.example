# Copy this file to .env and replace every placeholder before starting.
# Do not commit .env, service-account JSON, or passwords.
NODE_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8085
SESSION_SECRET=replace-with-a-long-random-value

# TraverseX control/report database. This is not a projection target.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=traversex
DATABASE_USER=traversex
DATABASE_PASSWORD=replace-with-a-dedicated-password

# These are optional compatibility/reference defaults. The Admin registry
# stores the Firebase ID and credential path for each registered project.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CREDENTIALS_FILE=/etc/traversex/firebase/project-a.json

# The worker instance must match an ACTIVE Admin project_key.
TRAVERSEX_INSTANCE_ID=project-a
# Use * to project every document project_key in the registered Firebase project.
TRAVERSEX_SOURCE_PROJECT_KEY=*
